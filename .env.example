# ─────────────────────────────────────────────────────────────────
# Copie para .env e preencha antes de rodar:
#   cp .env.example .env
#
# Portas expostas pelo docker-compose.yml:
#   Web (nginx)      : 80
#   API (FastAPI)    : 8020
#   Supabase Kong    : 8100   ← VITE_SUPABASE_URL aponta aqui
#   Supabase Studio  : 8400
#   Inbucket (email) : 9000
# ─────────────────────────────────────────────────────────────────

# ── Banco de dados ────────────────────────────────────────────────
POSTGRES_PASSWORD=troque-por-senha-forte

# ── JWT ───────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-secret-de-pelo-menos-32-chars

# ── Chaves Supabase ───────────────────────────────────────────────
# As chaves abaixo são DEMO e funcionam apenas com o JWT_SECRET:
#   your-super-secret-and-long-jwt-secret-key-that-is-at-least-32-characters-long
#
# Para gerar chaves a partir do seu JWT_SECRET customizado:
#   https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7W9oRh3lAE1PNhCGjVcTBR97rFNPzBRfMBQ
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0

# ── URLs (ajuste para o IP do servidor) ───────────────────────────
API_EXTERNAL_URL=http://192.168.1.16:8300
SITE_URL=http://192.168.1.16
ADDITIONAL_REDIRECT_URLS=http://192.168.1.16/auth/callback

# ── Realtime ──────────────────────────────────────────────────────
# Gere com: openssl rand -hex 64
SECRET_KEY_BASE=troque-por-chave-de-pelo-menos-64-chars

# ── Studio / Dashboard ────────────────────────────────────────────
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=troque-por-senha-forte

# ── App web (baked in no build Docker — veja apps/web/Dockerfile) ─
VITE_SUPABASE_URL=http://192.168.1.16:8300
VITE_SUPABASE_ANON_KEY=  # mesmo valor de ANON_KEY acima
VITE_API_URL=http://192.168.1.16:8020

# ── Backend FastAPI ───────────────────────────────────────────────
SUPABASE_URL=http://kong:8000
SUPABASE_SERVICE_ROLE_KEY=  # mesmo valor de SERVICE_ROLE_KEY acima
SUPABASE_JWT_SECRET=        # mesmo valor de JWT_SECRET acima
CRON_SECRET=change-me-in-prod
RESEND_API_KEY=re_...
APP_URL=http://192.168.1.16

# ── Agente de saúde financeira (LangChain + Claude) ───────────────
# Obrigatório para o agente funcionar (botão "Analisar agora" no dashboard).
ANTHROPIC_API_KEY=sk-ant-...
# Opcionais (têm default no código):
# HEALTH_MODEL=claude-sonnet-4-6
# EMBED_MODEL=intfloat/multilingual-e5-small
